# ============================================================
# AI Hackathon 2026 智能评审Agent系统 - 环境变量配置
# 复制为 .env 后填入实际值
# ============================================================

# --- 应用基础 ---
APP_NAME=HackathonReviewAgent
ENV=development
DEBUG=false
SECRET_KEY=change-this-to-random-secret-key-2026

# --- 数据库 ---
DATABASE_URL=postgresql://hackathon:hackathon_pass@localhost:5432/hackathon_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO 对象存储 ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hackathon_minio
MINIO_SECRET_KEY=hackathon_minio_secret
MINIO_SECURE=false
MINIO_BUCKET_SUBMISSIONS=submissions
MINIO_BUCKET_REPORTS=reports

# --- LLM API Keys ---
# 主评审模型 (GPT-4o / Claude 3.5 Sonnet)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Verifier模型 (Gemini 2.5 Flash)
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.5-flash

# 创新性感知模型 (Qwen3-72B)
QWEN_API_KEY=your-qwen-key-here
QWEN_MODEL=qwen3-72b

# Embedding模型
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- 沙箱配置 ---
SANDBOX_DOCKER_HOST=tcp://localhost:2375
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g
SANDBOX_TIMEOUT=600
SANDBOX_MAX_CONCURRENT=10

# --- 评审配置 ---
# Verifier重复验证次数
VERIFIER_K=5
# Verifier评分粒度(1-100,步长5)
VERIFIER_GRANULARITY=20
# 置信度阈值(低于此值触发人工复核)
CONFIDENCE_THRESHOLD=0.80
# 各维度评分方差阈值
VARIANCE_THRESHOLD=225

# --- 日志 ---
LOG_LEVEL=INFO
LOG_FORMAT=json
