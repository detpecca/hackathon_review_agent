FROM python:3.11-slim

WORKDIR /app

# 安装Docker CLI（静态二进制，绕过apt-get网络问题）
RUN python -c "import urllib.request; urllib.request.urlretrieve('https://download.docker.com/linux/static/stable/x86_64/docker-25.0.3.tgz', '/tmp/docker.tgz')" && \
    tar xzf /tmp/docker.tgz -C /tmp && \
    cp /tmp/docker/docker /usr/local/bin/docker && \
    chmod +x /usr/local/bin/docker && \
    rm -rf /tmp/docker /tmp/docker.tgz

# 复制依赖文件
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制源代码
COPY . .

# 创建上传目录
RUN mkdir -p /app/uploads && chmod 777 /app/uploads

CMD ["celery", "-A", "src.celery_app", "worker", "-l", "info"]
